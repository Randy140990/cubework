{
  "schemaVersion": 1,
  "id": "cubework",
  "version": "${version}",
  "name": "Cubework",
  "description": "Vanilla blocks in every shape: stairs, slabs, slopes, arches, round columns, window frames, patterns and more, with a shape wheel, a terrain brush and builder's guides.",
  "authors": [
    "Inside the Cube"
  ],
  "license": "All rights reserved",
  "icon": "assets/cubework/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.insidethecube.cubework.Cubework"
    ],
    "client": [
      "com.insidethecube.cubework.client.CubeworkClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "mixins": [
    "cubework.mixins.json",
    "cubework.continuity.mixins.json"
  ],
  "suggests": {
    "continuity": "*",
    "modernfix": "*"
  }
}